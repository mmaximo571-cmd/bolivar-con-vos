# ============================================================
#  Lo que NO se sube al repositorio.
#
#  Ojo: acá va basura del sistema, no claves. La clave que está
#  en config.js (sb_publishable_...) es pública a propósito y
#  TIENE que subirse, si no la app no se conecta a Supabase.
#
#  La que nunca va, ni acá ni en ningún archivo, es la secreta
#  (sb_secret_...). Esa vive solo en el tablero de Supabase.
# ============================================================

# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS, por si alguien del equipo trabaja en Mac
.DS_Store

# Editores
.vscode/
.idea/
*.swp

# Archivos temporales de Office y de los navegadores
~$*
*.tmp
*.crdownload

# graphify: rutas de esta maquina, cache y copias de respaldo locales.
# El grafo en si (graph.json, GRAPH_REPORT.md, graph.html) si se sube.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/*.sig
graphify-out/cache/
graphify-out/20*/
graphify-out/.graphify_analysis.json

# Cosas de Claude Code: la configuracion del servidor de prueba lleva
# rutas de esta maquina, no sirven en otra. Se suben solo el hook que
# instala graphify en las sesiones en la nube y su registro.
.claude/*
!.claude/settings.json
!.claude/hooks/
